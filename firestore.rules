rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && userProfile().data.role in ["admin", "Admin", "ADMIN"];
    }

    function isTeamMember() {
      return signedIn();
    }

    function onlyStockFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(["quantity", "stock", "updatedAt"]);
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isTeamMember();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read: if isTeamMember();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /stockIn/{entryId} {
      allow read: if isTeamMember();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /stockOut/{entryId} {
      allow read: if isTeamMember();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /stockMovements/{entryId} {
      allow read: if isTeamMember();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isTeamMember();
      allow create, update, delete: if isAdmin();
    }
  }
}
